# Ambiente
NODE_ENV="development"
PORT="3000"
# Na Netlify, a variável URL fornecida pela plataforma é usada automaticamente.
APP_URL="http://localhost:3000"

# Necessária na Netlify enquanto a API usar Functions em modo de compatibilidade Lambda.
# Copie a connection string em Data & Storage > Database e cadastre-a como segredo.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Segurança administrativa
# Use valores exclusivos e fortes em produção (mínimo indicado: 32 caracteres para o segredo).
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-initial-password"

# Checkout Integrado InfinitePay
INFINITEPAY_HANDLE="replace-with-your-infinite-tag"
INFINITEPAY_MODE="sandbox"

# Sobrescreva somente se a InfinitePay orientar endpoints diferentes para sua conta.
INFINITEPAY_CHECKOUT_API_URL="https://api.checkout.infinitepay.io/links"
INFINITEPAY_PAYMENT_CHECK_API_URL="https://api.infinitepay.io/invoices/public/checkout/payment_check"
